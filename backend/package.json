{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "jest --detectOpenHandles --runInBand --forceExit",
    "db:gen": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "build": "tsc && rm -rf dist/generated && cp -R generated dist/generated && if [ -d images ]; then cp -R images dist/images; fi && if [ -d old_items ]; then cp -R old_items dist/old_items; fi",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^10.42.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^5.1.1",
    "ioredis": "^5.10.0",
    "mime-types": "^3.0.2",
    "morgan": "~1.12.1",
    "mysql2": "^2.3.3",
    "node-cache": "^5.1.2",
    "node-schedule": "^2.1.1",
    "p-limit": "3.0.0",
    "sharp": "^0.34.3",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.9.0": true,
    "@prisma/engines@6.9.0": true,
    "@prisma/client@6.9.0": true,
    "sharp@0.34.5": true
  }
}
